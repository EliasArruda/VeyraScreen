@page "/"
@using VeyraScreen.Shared.Components.UI.Button
@using VeyraScreen.Shared.Components.UI.Divider

<div class="w-full h-full flex flex-col gap-4 items-center justify-center">
  <article class="flex flex-col leading-10">
    <div class="flex flex-row justify-center items-center gap-2.5">
      <p class="bg-primary size-3.5 rounded-full animate-pulse duration-150"></p>
      <span class="tracking-[.45em] font-semibold text-3xl">VEYRA</span>
    </div>
    <span class="text-muted-foreground text-md tracking-widest">Share your screen. Nothing else</span>
  </article>

  <section class="w-1/3 p-6 flex flex-col gap-4 items-center border border-border">
    <Button Variants="ButtonVariant.Primary" Href="/Broadcast" Icon="Lucide.ScreenShare"
            IconPosition="ButtonIconPosition.Left" FullWidth Class="rounded-xs">Share my
      screen</Button>
      <Divider Text="or join a room" />
    </section>
  </div>
