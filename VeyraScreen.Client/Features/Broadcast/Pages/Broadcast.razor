@page "/Broadcast"
@rendermode InteractiveAuto
@implements IAsyncDisposable
@using VeyraScreen.Shared.Contracts.Room
@using VeyraScreen.Client.Features.Broadcast.Components
@inject IRoomService Rooms
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Set up your screen · Veyra</PageTitle>

<div class="broadcast-page">
    <a href="/" class="back-link"><Blazicon Svg="Lucide.ArrowLeft" /> Back to home</a>
    <div class="broadcast-layout">
        <section class="broadcast-intro">
            <span class="section-label">Screen studio</span>
            <h1>Your screen.<br /> Ready to share.</h1>
            <p>Set your capture preferences, then choose a tab, window, or entire screen.</p>
            <div class="intro-note"><Blazicon Svg="Lucide.Monitor" /><span>You choose what’s visible.<br />Stop capturing whenever you like.</span></div>
        </section>

        <section class="capture-settings" aria-labelledby="settings-heading" aria-busy="@_busy">
            <header class="settings-heading">
                <div><h2 id="settings-heading">Capture settings</h2><p>A good picture starts here.</p></div>
                <Blazicon Svg="Lucide.SlidersHorizontal" />
            </header>
            <fieldset disabled="@(_busy || !_ready)">
                <legend class="sr-only">Screen capture preferences</legend>
                <CardBroadcast @bind-Value="Resolution" Label="Resolution" Description="Higher resolution captures more detail." Icon="Lucide.Monitor" Options="ResolutionOptions" />
                <CardBroadcast @bind-Value="FrameRate" Label="Frame rate" Description="60 FPS is ideal for smooth motion." Icon="Lucide.Gauge" Options="FrameRateOptions" />
                <CardBroadcast @bind-Value="AudioValue" Label="System audio" Description="Choose a browser tab and enable Share tab audio in the picker." Icon="Lucide.Volume2" Options="AudioOptions" />
            </fieldset>
            <div class="capture-summary"><span>Capture target</span><strong>@(Resolution == "2160" ? "4K" : $"{Resolution}p") <span>·</span> @FrameRate FPS <span>·</span> @(AudioValue == "true" ? "Audio requested" : "No audio")</strong></div>
            @if (_error is not null)
            {
                <p class="feedback feedback-error" role="alert">@_error</p>
            }
            @if (_unsupported)
            {
                <p class="feedback feedback-error" role="alert">Screen capture needs a supported desktop browser and HTTPS or localhost.</p>
            }
            <button @ref="_captureButton" @onclick="CreateRoom" class="action-button primary-button capture-button"
                    disabled="@(_busy || !_ready || _unsupported)" data-width="@Width" data-height="@Resolution" data-fps="@FrameRate" data-audio="@AudioValue">
                <Blazicon Svg="Lucide.ScreenShare" />
                @(_busy ? "Preparing your screen…" : !_ready ? "Getting ready…" : "Choose a screen")
                @if (!_busy) { <Blazicon Svg="Lucide.ArrowRight" /> }
            </button>
            <p class="settings-footnote">Opens your browser’s screen picker. Actual quality depends on your display and browser.</p>
        </section>
    </div>
    <p class="scope-note">Share the room link so others can watch. You can change quality, frame rate, and audio while broadcasting.</p>
</div>

@code {
    private string Resolution { get; set; } = "1080";
    private string FrameRate { get; set; } = "30";
    private string AudioValue { get; set; } = "true";
    private int Width => Resolution switch { "720" => 1280, "1080" => 1920, "1440" => 2560, "2160" => 3840, _ => 1920 };
    private ElementReference _captureButton;
    private bool _ready, _unsupported, _busy, _navigated, _disposed;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _unsupported = !await JS.InvokeAsync<bool>("veyraScreen.bindCapture", _captureButton); }
        catch (JSException) { _unsupported = true; }
        _ready = true;
        StateHasChanged();
    }

    private async Task CreateRoom()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            _error = await JS.InvokeAsync<string?>("veyraScreen.completeCapture");
            if (_error is not null || _disposed) return;
            var created = await Rooms.CreateRoomAsync(new(Width, int.Parse(Resolution), int.Parse(FrameRate), bool.Parse(AudioValue)));
            if (_disposed) return;
            var room = created.Room;
            if (!await JS.InvokeAsync<bool>("veyraScreen.assignRoom", room.Id, created.HostToken))
            {
                _error = "Capture ended before the room was ready. Choose your screen again.";
                return;
            }
            _navigated = true;
            Navigation.NavigateTo($"/room/{room.Id}");
        }
        catch (Exception exception) when (exception is HttpRequestException or JSException or TaskCanceledException)
        {
            _error = "We couldn’t prepare your room. Check your connection and try again.";
            await StopCapture();
        }
        finally { _busy = false; }
    }

    private async Task StopCapture()
    {
        try { await JS.InvokeVoidAsync("veyraScreen.stop"); }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (!_ready) return;
        try { await JS.InvokeVoidAsync("veyraScreen.unbindCapture", _captureButton); }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException) { }
        if (!_navigated) await StopCapture();
    }

    private static readonly Dictionary<string, string> ResolutionOptions = new() { ["720"] = "720p · HD", ["1080"] = "1080p · Full HD", ["1440"] = "1440p · QHD", ["2160"] = "4K · Ultra HD" };
    private static readonly Dictionary<string, string> FrameRateOptions = new() { ["30"] = "30 FPS", ["60"] = "60 FPS", ["120"] = "120 FPS", ["240"] = "240 FPS" };
    private static readonly Dictionary<string, string> AudioOptions = new() { ["false"] = "Off", ["true"] = "On, when supported" };
}
