@using Blazicons

<div class="setting-row">
    <div class="setting-description">
        <Blazicon Svg="@Icon" />
        <div><label for="@_id">@Label</label><p id="@(_id + "-hint")">@Description</p></div>
    </div>
    <select id="@_id" aria-describedby="@(_id + "-hint")" @bind="Value" @bind:after="OnValueChanged">
        @foreach (var option in Options)
        {
            <option value="@option.Key">@option.Value</option>
        }
    </select>
</div>

@code {
    private readonly string _id = $"capture-{Guid.NewGuid():N}";
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public SvgIcon? Icon { get; set; }
    [Parameter] public Dictionary<string, string> Options { get; set; } = new();
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    private Task OnValueChanged() => ValueChanged.InvokeAsync(Value);
}
